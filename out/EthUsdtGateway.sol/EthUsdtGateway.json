s\":false,\"inputs\":[{\"indexed\":true,\"internalType\":\"address\",\"name\":\"depositor\",\"type\":\"address\"},{\"indexed\":true,\"internalType\":\"address\",\"name\":\"xodeBeneficiary\",\"type\":\"address\"},{\"indexed\":false,\"internalType\":\"uint256\",\"name\":\"usdtAmount\",\"type\":\"uint256\"},{\"indexed\":true,\"internalType\":\"uint256\",\"name\":\"depositNonce\",\"type\":\"uint256\"}],\"name\":\"Deposited\",\"type\":\"event\"},{\"anonymous\":false,\"inputs\":[{\"indexed\":true,\"internalType\":\"address\",\"name\":\"previousOwner\",\"type\":\"address\"},{\"indexed\":true,\"internalType\":\"address\",\"name\":\"newOwner\",\"type\":\"address\"}],\"name\":\"OwnerTransferred\",\"type\":\"event\"},{\"anonymous\":false,\"inputs\":[{\"indexed\":false,\"internalType\":\"bool\",\"name\":\"paused\",\"type\":\"bool\"}],\"name\":\"PausedSet\",\"type\":\"event\"},{\"anonymous\":false,\"inputs\":[{\"indexed\":true,\"internalType\":\"address\",\"name\":\"depositor\",\"type\":\"address\"},{\"indexed\":true,\"internalType\":\"address\",\"name\":\"xodeBeneficiary\",\"type\":\"address\"},{\"indexed\":false,\"internalType\":\"uint256\",\"name\":\"usdtAmount\",\"type\":\"uint256\"},{\"indexed\":true,\"internalType\":\"uint256\",\"name\":\"depositNonce\",\"type\":\"uint256\"},{\"indexed\":false,\"internalType\":\"uint256\",\"name\":\"minXonOut\",\"type\":\"uint256\"}],\"name\":\"SwapDeposited\",\"type\":\"event\"},{\"anonymous\":false,\"inputs\":[{\"indexed\":true,\"internalType\":\"address\",\"name\":\"to\",\"type\":\"address\"},{\"indexed\":false,\"internalType\":\"uint256\",\"name\":\"amount\",\"type\":\"uint256\"}],\"name\":\"Withdrawn\",\"type\":\"event\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"usdtAmount\",\"type\":\"uint256\"},{\"internalType\":\"address\",\"name\":\"xodeBeneficiary\",\"type\":\"address\"}],\"name\":\"deposit\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"usdtAmount\",\"type\":\"uint256\"},{\"internalType\":\"address\",\"name\":\"xodeBeneficiary\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"minXonOut\",\"type\":\"uint256\"}],\"name\":\"depositForSwap\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"depositNonce\",\"outputs\":[{\"internalType\":\"uint256\",\"name\":\"\",\"type\":\"uint256\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"owner\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"paused\",\"outputs\":[{\"internalType\":\"bool\",\"name\":\"\",\"type\":\"bool\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"bool\",\"name\":\"paused_\",\"type\":\"bool\"}],\"name\":\"setPaused\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"newOwner\",\"type\":\"address\"}],\"name\":\"transferOwnership\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"},{\"inputs\":[],\"name\":\"usdt\",\"outputs\":[{\"internalType\":\"contract IERC20\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"to\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"amount\",\"type\":\"uint256\"}],\"name\":\"withdraw\",\"outputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\"}],\"devdoc\":{\"kind\":\"dev\",\"methods\":{},\"version\":1},\"userdoc\":{\"events\":{\"SwapDeposited(address,address,uint256,uint256,uint256)\":{\"notice\":\"A deposit to be paid at the Xode DEX's market price (`XonVendingMachine.settleExternalSwap`) rather than the vending contract's fixed rate. `minXonOut` (18-decimal units) is the least XON the depositor accepts; if the pool can't give that much, the relayer refunds them.\"}},\"kind\":\"user\",\"methods\":{\"deposit(uint256,address)\":{\"notice\":\"Deposits `usdtAmount` USDT (requires a prior `usdt.approve(address(this), usdtAmount)`) and records `xodeBeneficiary` as who should receive the resulting XON on Xode. The relayer picks this up from the `Deposited` event and pays out for its `usdtAmount` - which is what actually arrived in this contract, not what was asked for, so a token that takes a fee on transfer (Ethereum USDT has a fee switch, currently off) can never be paid out above what the gateway really holds.\"},\"depositForSwap(uint256,address,uint256)\":{\"notice\":\"Like `deposit`, but asks to be paid at the Xode DEX's market price, receiving at least `minXonOut` XON (18-decimal units, as Solidity sees native XON on Xode) or a refund. Set it from a fresh quote minus your slippage tolerance. If USDT ever charges a transfer fee, the swap is for what arrived, so a tight minimum may then be refunded instead.\"}},\"notice\":\"Deployed on Ethereum (not Xode). Accepts real USDT from a depositor who wants XON on Xode in return, and records which Xode address (`xodeBeneficiary`) should receive it - there is no cross-chain callback here, so a separate relayer service watches `Deposited` events on this contract and calls `XonVendingMachine.settleExternalPurchase` on Xode to actually pay out. `depositForSwap` is the market-price variant: it emits `SwapDeposited` with the depositor's minimum, and the relayer pays it with `settleExternalSwap` (a DEX swap on Xode) or refunds it. This contract is a custodial escrow, not a bridge: USDT deposited here just sits in this contract's balance under `owner`'s control (via `withdraw`) until manually moved - there is no on-chain mechanism connecting Ethereum and Xode (Xode has no live Snowbridge connection as of writing). The XON payout on Xode is entirely a promise kept by whoever runs the relayer and controls `owner`/`relayer` here and the corresponding `relayer` role on `XonVendingMachine` - securing those keys (and this contract's `owner` key, which can drain the whole USDT balance) is the actual security boundary of this leg, not this contract's code.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"src/ethereum/EthUsdtGateway.sol\":\"EthUsdtGateway\"},\"evmVersion\":\"cancun\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":true,\"runs\":200},\"remappings\":[\":forge-std/=lib/forge-std/src/\"]},\"sources\":{\"src/ethereum/EthUsdtGateway.sol\":{\"keccak256\":\"0x47f98d6ef948358e4105d1bbf2837c5de48ca3ebbb4e1cf6e02aef5059a3c29e\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://ed0d8a62ad932e2bc19a107faba57e7f0ee8628715eceb4f4b9809d3e594ed1d\",\"dweb:/ipfs/QmZT97zjZqyiVCd1hRG3W6s9o4uuJoZ3ounbvSrkVj3YFT\"]},\"src/interfaces/IERC20.sol\":{\"keccak256\":\"0x311bc8e76659b8003b582a1493843da9b42dde90dcf11e05cb91cb9ccbf3f208\",\"license\":\"MIT\",\"urls\":[\"bzz-raw://f8dc24b42c9d5a029fbeeee8f5850cef9132beae135fba84e79961bb185cead4\",\"dweb:/ipfs/QmPi2GVAVZqkgC1HFQJWavZ4TCSs6TMhEgU2xhnjsQeiFh\"]}},\"version\":1}","metadata":{"compiler":{"version":"0.8.24+commit.e11b9ed9"},"language":"Solidity","output":{"abi":[{"inputs":[{"internalType":"address","name":"usdtToken","type":"address"},{"internalType":"address","name":"owner_","type":"address"}],"stateMutability":"nonpayable","type":"constructor"},{"inputs":[],"type":"error","name":"IsPaused"},{"inputs":[],"type":"error","name":"NotOwner"},{"inputs":[],"type":"error","name":"Reentrant"},{"inputs":[],"type":"error","name":"UsdtTransferFailed"},{"inputs":[],"type":"error","name":"ZeroAddress"},{"inputs":[],"type":"error","name":"ZeroAmount"},{"inputs":[{"internalType":"address","name":"depositor","type":"address","indexed":true},{"internalType":"address","name":"xodeBeneficiary","type":"address","indexed":true},{"internalType":"uint256","name":"usdtAmount","type":"uint256","indexed":false},{"internalType":"uint256","name":"depositNonce","type":"uint256","indexed":true}